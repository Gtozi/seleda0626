# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Never expose this to client, use inside server-side code block.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE_CONFIGURATION: Keys used by client side Supabase SDK to connect to PostgreSQL.
# In production, input actual values in AI Studio Secrets settings panels.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-role-key"

# SERVER_SUPABASE_CONFIGURATION: Server-only credentials for DB-backed auth,
# sessions, permissions, audit events, and protected mutations.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser and never prefix it with VITE_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AUTH_CONFIGURATION
AUTH_SECRET="replace-with-long-random-secret"
DEV_LOGIN_PASSWORD="admin123"

# SMTP_CONFIGURATION: Optional. When all of SMTP_HOST, SMTP_USER and SMTP_PASS
# are set, the /api/reports/email endpoint performs real email dispatch.
# Otherwise dispatches are recorded/queued and logged to the audit trail.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="reports@your-hotel.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="SELEDA Hotel ERP <reports@your-hotel.com>"
